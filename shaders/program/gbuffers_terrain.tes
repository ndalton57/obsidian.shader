/*
--------------------------------------------------------------------------------

  Tachyon Shader (a fork of SixthSurge's Photon Shaders)

  program/gbuffers_terrain.tes:
  Shader Grass. Tessellation EVALUATION shader for the
  SOLID terrain program. Barycentrically interpolates each subdivided vertex of
  a grass-block top (scene_pos etc.), so the geometry shader gets many small
  triangles to grow blades on. Flat per-face attributes come from vertex 0.
  Uses triangles, fractional_odd_spacing, ccw.

--------------------------------------------------------------------------------
*/

#include "/include/global.glsl"

#if defined GRASS_GEOMETRY && defined POM && !defined PROGRAM_GBUFFERS_TERRAIN_SOLID
#undef POM
#endif

layout(triangles, fractional_odd_spacing, ccw) in;

in GrassVertex {
    vec2 uv;
    vec3 scene_pos;
    vec4 tint;
    flat uint material_mask;
    flat mat3 tbn;
    vec2 light_levels;
    float vanilla_ao;
#ifdef POM
    vec2 atlas_tile_coord;
    vec3 tangent_pos;
    flat vec2 atlas_tile_offset;
    flat vec2 atlas_tile_scale;
#endif
} te_in[];

out GrassVertex {
    vec2 uv;
    vec3 scene_pos;
    vec4 tint;
    flat uint material_mask;
    flat mat3 tbn;
    vec2 light_levels;
    float vanilla_ao;
#ifdef POM
    vec2 atlas_tile_coord;
    vec3 tangent_pos;
    flat vec2 atlas_tile_offset;
    flat vec2 atlas_tile_scale;
#endif
} te_out;

#define bary(a, b, c) \
    (gl_TessCoord.x * (a) + gl_TessCoord.y * (b) + gl_TessCoord.z * (c))

void main() {
    gl_Position = bary(
        gl_in[0].gl_Position, gl_in[1].gl_Position, gl_in[2].gl_Position
    );

    te_out.uv = bary(te_in[0].uv, te_in[1].uv, te_in[2].uv);
    te_out.scene_pos
        = bary(te_in[0].scene_pos, te_in[1].scene_pos, te_in[2].scene_pos);
    te_out.tint = bary(te_in[0].tint, te_in[1].tint, te_in[2].tint);
    te_out.light_levels = bary(
        te_in[0].light_levels, te_in[1].light_levels, te_in[2].light_levels
    );
    te_out.vanilla_ao = bary(
        te_in[0].vanilla_ao, te_in[1].vanilla_ao, te_in[2].vanilla_ao
    );

    // Flat per-face attributes: take the provoking (first) vertex.
    te_out.material_mask = te_in[0].material_mask;
    te_out.tbn = te_in[0].tbn;

#ifdef POM
    te_out.atlas_tile_coord = bary(
        te_in[0].atlas_tile_coord,
        te_in[1].atlas_tile_coord,
        te_in[2].atlas_tile_coord
    );
    te_out.tangent_pos = bary(
        te_in[0].tangent_pos, te_in[1].tangent_pos, te_in[2].tangent_pos
    );
    te_out.atlas_tile_offset = te_in[0].atlas_tile_offset;
    te_out.atlas_tile_scale = te_in[0].atlas_tile_scale;
#endif
}
