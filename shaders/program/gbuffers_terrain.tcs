/*
--------------------------------------------------------------------------------

  Tachyon Shader (a fork of SixthSurge's Photon Shaders)

  program/gbuffers_terrain.tcs:
  Shader Grass. Tessellation CONTROL shader for the SOLID
  terrain program. Subdivides grass-block tops into many small triangles so the
  geometry shader can grow one blade on each (-> denser grass). Every
  other surface is left at tessellation level 1 (no subdivision, no cost).
  Subdivision levels scale with GRASS_DENSITY and distance.

--------------------------------------------------------------------------------
*/

#include "/include/global.glsl"
#include "/include/misc/material_masks.glsl"

// Voxel lookup for the grower-face election (must match the GS exactly). Only
// available with Colored Lights (that's what builds the voxel volume).
#ifdef COLORED_LIGHTS
uniform vec3 cameraPosition;
uniform mat4 gbufferModelViewInverse;
uniform usampler3D voxel_sampler;
#if PROCEDURAL_GEOMETRY_MODE == 3
uniform usampler3D grass_face_sampler; // Shader Grass: face mask (mode 3 shadow pass)
#elif PROCEDURAL_GEOMETRY_MODE >= 4
uniform int frameCounter; // Shader Grass mode 4: camera-mask temporal stamp + ping-pong parity
uniform vec3 cameraPositionFract; // mode 4: exact world-index mask cell (Iris split camera)
uniform ivec3 cameraPositionInt;
uniform usampler3D grass_face_sampler_a; // mode 4: DOUBLE-BUFFERED camera mask (read the non-written one)
uniform usampler3D grass_face_sampler_b;
#endif
#include "/include/lighting/lpv/voxelization.glsl"
#include "/include/misc/grass_election.glsl"
#endif

// Keep the varying block identical across vsh/tcs/tes/gsh/fsh. POM survives only
// on the solid program (this file is only ever compiled for it).
#if defined GRASS_GEOMETRY && defined POM && !defined PROGRAM_GBUFFERS_TERRAIN_SOLID
#undef POM
#endif

layout(vertices = 3) out;

in GrassVertex {
    vec2 uv;
    vec3 scene_pos;
    vec4 tint;
    flat uint material_mask;
    flat mat3 tbn;
    vec2 light_levels;
    float vanilla_ao;
    flat vec3 block_center;
#ifdef POM
    vec2 atlas_tile_coord;
    vec3 tangent_pos;
    flat vec2 atlas_tile_offset;
    flat vec2 atlas_tile_scale;
#endif
} tc_in[];

out GrassVertex {
    vec2 uv;
    vec3 scene_pos;
    vec4 tint;
    flat uint material_mask;
    flat mat3 tbn;
    vec2 light_levels;
    float vanilla_ao;
    flat vec3 block_center;
#ifdef POM
    vec2 atlas_tile_coord;
    vec3 tangent_pos;
    flat vec2 atlas_tile_offset;
    flat vec2 atlas_tile_scale;
#endif
} tc_out[];

void main() {
    // Per-control-point passthrough.
    gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;

    tc_out[gl_InvocationID].uv = tc_in[gl_InvocationID].uv;
    tc_out[gl_InvocationID].scene_pos = tc_in[gl_InvocationID].scene_pos;
    tc_out[gl_InvocationID].tint = tc_in[gl_InvocationID].tint;
    tc_out[gl_InvocationID].material_mask = tc_in[gl_InvocationID].material_mask;
    tc_out[gl_InvocationID].tbn = tc_in[gl_InvocationID].tbn;
    tc_out[gl_InvocationID].light_levels = tc_in[gl_InvocationID].light_levels;
    tc_out[gl_InvocationID].vanilla_ao = tc_in[gl_InvocationID].vanilla_ao;
    tc_out[gl_InvocationID].block_center = tc_in[gl_InvocationID].block_center;
#ifdef POM
    tc_out[gl_InvocationID].atlas_tile_coord = tc_in[gl_InvocationID].atlas_tile_coord;
    tc_out[gl_InvocationID].tangent_pos = tc_in[gl_InvocationID].tangent_pos;
    tc_out[gl_InvocationID].atlas_tile_offset = tc_in[gl_InvocationID].atlas_tile_offset;
    tc_out[gl_InvocationID].atlas_tile_scale = tc_in[gl_InvocationID].atlas_tile_scale;
#endif

    // One thread decides the tessellation levels for the whole patch.
    if (gl_InvocationID == 0) {
        bool grass = false;
        float vDist = 0.0;
#ifdef SHADER_GRASS
        // Distance/range and the grower election are keyed on the BLOCK center
        // (not the triangle centroid) so every face of a block agrees and the
        // whole block tessellates as one unit. Must match the GS gate exactly.
        if (tc_in[0].material_mask == uint(MATERIAL_GRASS_BLOCK)) {
            vec3 bc = tc_in[0].block_center;
            vDist = length(bc);
            bool in_range = dot(bc, bc) < (GRASS_RANGE * GRASS_RANGE);
#if defined COLORED_LIGHTS && PROCEDURAL_GEOMETRY_MODE >= 2
            // Tessellate the single elected grower face of an exposed grass block
            // (the GS runs the identical election, so they never disagree).
            grass = in_range && grass_air_above(bc)
                && grass_is_grower(bc, tc_in[0].tbn[2]);
#else
            // Mode 1 (Top Only): grass-block tops only.
            grass = in_range && tc_in[0].tbn[2].y > 0.9;
#endif
        }
#endif

        if (grass) {
            // CONTINUOUS distance LOD. One blade per sub-triangle, so the level MUST vary
            // smoothly: a discrete step would retessellate a block as you approach and
            // every blade would JUMP. A float level feeds fractional_odd_spacing (TES),
            // which morphs smoothly. Full density up close, ~half by far range; cost
            // scales with level^2. See CLAUDE.md.
            float lvl = float(GRASS_GRID) * (1.0 - 0.5 * smoothstep(8.0, 28.0, vDist));

            gl_TessLevelOuter[0] = lvl;
            gl_TessLevelOuter[1] = lvl;
            gl_TessLevelOuter[2] = lvl;
            gl_TessLevelInner[0] = lvl;
        } else {
            // No subdivision: emit the original triangle unchanged.
            gl_TessLevelOuter[0] = 1.0;
            gl_TessLevelOuter[1] = 1.0;
            gl_TessLevelOuter[2] = 1.0;
            gl_TessLevelInner[0] = 0.0;
        }
    }
}
